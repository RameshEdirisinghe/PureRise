# ── API ───────────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:5000/api

# ── Blockchain ────────────────────────────────────────────────────────────────
# Deployed contract address on Sepolia Testnet
VITE_CONTRACT_ADDRESS=0xYourDeployedContractAddressHere

# Chain ID for Sepolia (do not change)
VITE_SEPOLIA_CHAIN_ID=11155111

# (Optional) Infura Project ID for read-only RPC provider
VITE_INFURA_API_KEY=your_infura_project_id_here
